# OmniRoute AI Gateway (OpenAI-compatible inference)
# The deployed OmniRoute domain or API base. Trailing /api/v1 is appended automatically.
OMNIROUTE_API_BASE="https://omniouter-vercel.vercel.app"

# Gateway access token. Sent as both "Authorization: Bearer" and "x-api-key".
OMNIROUTE_AI_API_KEY="my-super-secret-gateway-token-123"

# Optional: exact live model id or provider-scoped auto (e.g. "auto/kilo-gateway").
# Leave unset (or set to "auto") for automatic model selection.
OMNIROUTE_MODEL="auto"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"